<?xml version="1.0" encoding="UTF-8"?>
<!-- Deployment descriptor for Servlet 6.0 (Jakarta EE 10 / Tomcat 10.1). All servlet and filter mappings live here. -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>Student Admission and Profile Management Portal</display-name>

  <!-- ===== Filters. Order here is the order they run. ===== -->
  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>edu.kpriet.portal.web.SecurityHeadersFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Everything under /portal/ requires a signed-in session. -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>edu.kpriet.portal.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/portal/*</url-pattern>
  </filter-mapping>

  <!-- ===== Servlets ===== -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>edu.kpriet.portal.web.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>edu.kpriet.portal.web.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StudentListServlet</servlet-name>
    <servlet-class>edu.kpriet.portal.web.StudentListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StudentListServlet</servlet-name>
    <url-pattern>/portal/students</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StudentDetailServlet</servlet-name>
    <servlet-class>edu.kpriet.portal.web.StudentDetailServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StudentDetailServlet</servlet-name>
    <url-pattern>/portal/student</url-pattern>
  </servlet-mapping>

  <!-- Streams uploaded images and documents from the upload folder. -->
  <servlet>
    <servlet-name>FileServlet</servlet-name>
    <servlet-class>edu.kpriet.portal.web.FileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FileServlet</servlet-name>
    <url-pattern>/portal/file</url-pattern>
  </servlet-mapping>

  <!-- ===== Sessions: 30 minutes idle timeout, cookie only (never in the URL), not readable by JavaScript. ===== -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- Add <secure>true</secure> here when the site is served over HTTPS. -->
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- ===== Friendly error pages (no stack traces for visitors) ===== -->
  <error-page><error-code>400</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><error-code>403</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/views/error.jsp</location></error-page>
</web-app>
